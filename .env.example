# ==========================================
# Backend Environment Variables (Render)
# ==========================================
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
SESSION_SECRET=coordination_intelligence_super_secret_key_2026

# Neon Serverless PostgreSQL (Leave blank to use local store.json fallback)
DATABASE_URL=postgresql://user:password@ep-example.region.neon.tech/neondb?sslmode=require

# Google Gemini API Key (Leave blank to use realistic deterministic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL deployed on Vercel (for CORS allowance)
# Example: https://coordination-intelligence.vercel.app
CLIENT_ORIGIN=https://your-frontend-app.vercel.app

# ==========================================
# Frontend Environment Variables (Vercel)
# ==========================================
# Point to your Render API backend URL (ending in /api)
# Example: https://coordination-intelligence-api.onrender.com/api
# Leave unset or empty if testing locally with Vite proxy (/api)
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
